#!/usr/bin/env bash
# Fix coverage.json paths to match SonarQube expectations
# Converts absolute paths to relative paths

set -e

COVERAGE_FILE="${1:-coverage/coverage.json}"
PROJECT_BASE_DIR="${CI_PROJECT_DIR:-$(pwd)}"

if [ ! -f "$COVERAGE_FILE" ]; then
  echo "Error: Coverage file not found: $COVERAGE_FILE"
  exit 1
fi

echo "Converting absolute paths to relative paths in $COVERAGE_FILE..."

# Check if jq is available
if command -v jq &> /dev/null; then
  # Convert paths using jq (preferred method)
  jq ".files[] |= (.filename |= sub(\"^${PROJECT_BASE_DIR}/\"; \"\"))" \
    "$COVERAGE_FILE" > "${COVERAGE_FILE}.tmp" && \
    mv "${COVERAGE_FILE}.tmp" "$COVERAGE_FILE"
  
  # Verify conversion
  FIRST_PATH=$(jq -r '.files[0].filename' "$COVERAGE_FILE" 2>/dev/null || echo "")
  TOTAL_FILES=$(jq '.files | length' "$COVERAGE_FILE" 2>/dev/null || echo "0")
else
  # Fallback: use sed for path conversion (works without jq)
  echo "jq not available, using sed for path conversion..."
  sed -i.bak "s|\"${PROJECT_BASE_DIR}/|\"|g" "$COVERAGE_FILE"
  sed -i.bak "s|${PROJECT_BASE_DIR}/||g" "$COVERAGE_FILE"
  rm -f "${COVERAGE_FILE}.bak"
  
  # Extract first path for verification (basic check)
  FIRST_PATH=$(grep -o '"filename": "[^"]*"' "$COVERAGE_FILE" | head -1 | cut -d'"' -f4)
  TOTAL_FILES=$(grep -c '"filename":' "$COVERAGE_FILE" || echo "0")
fi

# Verify the conversion worked
if [[ "$FIRST_PATH" == /* ]]; then
  echo "Warning: Paths still appear to be absolute: $FIRST_PATH"
  echo "Project base dir was: $PROJECT_BASE_DIR"
  exit 1
fi

echo "✓ Paths converted successfully"
echo "  Sample path: $FIRST_PATH"
echo "  Total files: $TOTAL_FILES"
